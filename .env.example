# Server Configuration
PORT=3000
NODE_ENV=production

# yt-dlp Path (Supports relative path with ~, absolute path, or system command name)
YTDLP_PATH=~/bin/yt-dlp

# Security & Limits
MAX_CONCURRENT_PROCESSES=2
YTDLP_TIMEOUT_MS=60000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL_SECONDS=600

# File Cleanup Settings (Storage)
CLEANUP_INTERVAL_MS=300000
FILE_MAX_AGE_MS=1800000
